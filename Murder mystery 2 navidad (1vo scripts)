	local stripe = Instance.new("Frame")
	stripe.Size = UDim2.new(1, 0, 0, stripeHeight)
	stripe.Position = UDim2.new(0, 0, 0, (i - 1) * stripeHeight)
	stripe.BorderSizePixel = 0
	stripe.ZIndex = 1
	if i % 2 == 0 then
		stripe.BackgroundColor3 = Color3.fromRGB(255, 110, 0)
		stripe.BackgroundTransparency = 0.25
	else
		stripe.BackgroundColor3 = Color3.fromRGB(50, 20, 70)
		stripe.BackgroundTransparency = 0.25
	end
	stripe.Parent = movingStripes
end

