local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local farming = false
local speed = 20
local maxDistance = 120
local noclipConnection
local noclipOn = false
local farmToken = 0
local activeMovement = nil
local joinedContainer
local ignoredContainer
local farmedAny = false
local totalCoins = 0

local killAuraActive = false
local killAuraRange = 25
local auraPart = nil

local function getRoot()
	local char = player.Character
	return char and char:FindFirstChild("HumanoidRootPart")
end

local function getHumanoid()
	local char = player.Character
	return char and char:FindFirstChildOfClass("Humanoid")
end

local function getCoinContainer()
	local container = workspace:FindFirstChild("CoinContainer", true)
	if not container then
		for _, v in ipairs(workspace:GetChildren()) do
			if v.Name:lower():find("coin") or v.Name:lower():find("container") then
				container = v
				break
			end
		end
	end
	return container
end

local function setNoclip(on)
	if on == noclipOn then return end
	noclipOn = on

	if noclipConnection then
		noclipConnection:Disconnect()
		noclipConnection = nil
	end

	if on then
		noclipConnection = RunService.Stepped:Connect(function()
			local character = player.Character
			if character then
				for _, part in ipairs(character:GetChildren()) do
					if part:IsA("BasePart") then
						part.CanCollide = false
					end
				end
			end
		end)
	end
end

local function isCoin(obj)
	if not obj:IsA("BasePart") then return false end
	local name = obj.Name:lower()
	return name == "coin"
		or name == "coin_server"
		or name == "coincontainer"
		or name:find("coin")
		or name:find("snowball")
		or name:find("candy")
		or name:find("drop")
end

local function getCoins(container)
	local result = {}
	for _, obj in ipairs(container:GetDescendants()) do
		if isCoin(obj) and obj.Parent and obj.Transparency < 1 then
			table.insert(result, obj)
		end
	end
	return result
end

local function getNearestNewCoin(coins, used)
	local root = getRoot()
	if not root then return nil, math.huge end

	local nearest
	local nearestDistance = math.huge

	for _, coin in ipairs(coins) do
		if not used[coin] then
			local d = (root.Position - coin.Position).Magnitude
			if d < nearestDistance then
				nearestDistance = d
				nearest = coin
			end
		end
	end

	return nearest, nearestDistance
end

local function moveToCoin(targetPosition, token)
	local root = getRoot()
	local hum = getHumanoid()

	if not root or not hum or hum.Health <= 0 then return false end

	local distance = (root.Position - targetPosition).Magnitude
	local duration = math.max(distance / math.clamp(speed, 1, 50), 0.05)
	local startTime = tick()
	local startCFrame = root.CFrame
	local targetCFrame = CFrame.new(targetPosition + Vector3.new(0, 1, 0))

	activeMovement = true

	while activeMovement and farming and token == farmToken do
		local elapsed = tick() - startTime
		local alpha = math.clamp(elapsed / duration, 0, 1)

		root.CFrame = startCFrame:Lerp(targetCFrame, alpha)
		root.AssemblyLinearVelocity = Vector3.zero

		if alpha >= 1 then
			break
		end

		RunService.Heartbeat:Wait()
	end

	activeMovement = nil
	return true
end

local function farmLoop(token)
	local usedCoins = {}

	while farming and token == farmToken do
		local hum = getHumanoid()

		if not hum or hum.Health <= 0 or not getRoot() then
			joinedContainer = nil
			setNoclip(false)
			task.wait(0.2)
			continue
		end

		local container = getCoinContainer()

		if not container or container == ignoredContainer then
			joinedContainer = nil
			setNoclip(false)
			task.wait(0.2)
			continue
		end

		if container ~= joinedContainer then
			joinedContainer = container
			usedCoins = {}
			farmedAny = false
		end

		local coins = getCoins(container)

		if #coins == 0 then
			if farmedAny then
				ignoredContainer = nil
				farmedAny = false
			end
			setNoclip(false)
			task.wait(0.2)
			continue
		end

		local coin, dist = getNearestNewCoin(coins, usedCoins)

		if not coin then
			usedCoins = {}
			coin, dist = getNearestNewCoin(coins, usedCoins)
		end

		if coin and coin.Parent then
			if dist > maxDistance then
				setNoclip(false)
				task.wait(0.2)
				continue
			end

			usedCoins[coin] = true
			setNoclip(true)

			if moveToCoin(coin.Position, token) then
				farmedAny = true
				totalCoins += 1
			end

			task.wait(0.01)
		else
			task.wait(0.1)
		end
	end

	setNoclip(false)
end

local function useKnife()
	local char = player.Character
	if not char then return end
	local tool = char:FindFirstChildOfClass("Tool")
	local hum = getHumanoid()

	if not tool and hum then
		local backpack = player:FindFirstChild("Backpack")
		if backpack then
			for _, t in ipairs(backpack:GetChildren()) do
				if t:IsA("Tool") and (t.Name:lower():find("knife") or t.Name:lower():find("cuchillo") or t.Name:lower():find("murder")) then
					tool = t
					hum:EquipTool(tool)
					task.wait(0.03)
					break
				end
			end
			if not tool then
				tool = backpack:FindFirstChildOfClass("Tool")
				if tool then
					hum:EquipTool(tool)
					task.wait(0.03)
				end
			end
		end
	end

	if tool and tool.Parent == char then
		tool:Activate()
	end
end

local function updateAuraVisual(active)
	if active then
		if not auraPart then
			auraPart = Instance.new("Part")
			auraPart.Shape = Enum.PartType.Ball
			auraPart.Size = Vector3.new(killAuraRange * 2, killAuraRange * 2, killAuraRange * 2)
			auraPart.Transparency = 0.85
			auraPart.Color = Color3.fromRGB(255, 110, 0)
			auraPart.Material = Enum.Material.Neon
			auraPart.CanCollide = false
			auraPart.Anchored = true
			auraPart.Parent = workspace
		end
	else
		if auraPart then
			auraPart:Destroy()
			auraPart = nil
		end
	end
end

task.spawn(function()
	while true do
		pcall(function()
			if killAuraActive then
				local root = getRoot()
				local hum = getHumanoid()
				if root and hum and hum.Health > 0 then
					updateAuraVisual(true)
					if auraPart then
						auraPart.Size = Vector3.new(killAuraRange * 2, killAuraRange * 2, killAuraRange * 2)
						auraPart.CFrame = root.CFrame
					end

					local myPos = root.Position
					local hitTarget = false

					for _, p in ipairs(Players:GetPlayers()) do
						if p ~= player and p.Character then
							local otherRoot = p.Character:FindFirstChild("HumanoidRootPart")
							local otherHum = p.Character:FindFirstChildOfClass("Humanoid")
							if otherRoot and otherHum and otherHum.Health > 0 then
								local dist = (otherRoot.Position - myPos).Magnitude
								if dist <= killAuraRange then
									local oldPos = root.CFrame
									local currentCamCF = camera.CFrame
									local currentCamType = camera.CameraType

									camera.CameraType = Enum.CameraType.Scriptable
									camera.CFrame = currentCamCF

									root.CFrame = otherRoot.CFrame * CFrame.new(0, 0, 1.2)
									useKnife()
									task.wait(0.03)
									root.CFrame = oldPos

									camera.CameraType = currentCamType
									camera.CFrame = currentCamCF

									hitTarget = true
									break
								end
							end
						end
					end
				else
					updateAuraVisual(false)
				end
			else
				updateAuraVisual(false)
			end
		end)
		task.wait(0.05)
	end
end)

local function hookCharacter(char)
	joinedContainer = nil
	ignoredContainer = nil
	local hum = char:WaitForChild("Humanoid", 10)

	if hum then
		hum.Died:Connect(function()
			ignoredContainer = nil
			joinedContainer = nil
			setNoclip(false)
			activeMovement = nil
			updateAuraVisual(false)
		end)
	end
end

if player.Character then
	task.spawn(hookCharacter, player.Character)
end

player.CharacterAdded:Connect(hookCharacter)

local function toggleAutofarm(active)
	farming = active
	farmToken += 1

	if farming then
		joinedContainer = nil
		ignoredContainer = nil
		local token = farmToken
		task.spawn(function()
			farmLoop(token)
		end)
	else
		setNoclip(false)
		activeMovement = nil
	end
end

local function killAllVisual()
	local startTime = tick()
	local conn
	conn = RunService.Heartbeat:Connect(function()
		if tick() - startTime > 3 then
			conn:Disconnect()
			return
		end
		local myRoot = getRoot()
		if not myRoot then return end
		local myPos = myRoot.Position
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and p.Character then
				local otherRoot = p.Character:FindFirstChild("HumanoidRootPart")
				local hum = p.Character:FindFirstChildOfClass("Humanoid")
				if otherRoot and hum and hum.Health > 0 then
					otherRoot.CFrame = CFrame.new(myPos + Vector3.new(math.random(-3, 3), 0, math.random(-3, 3)))
				end
			end
		end
	end)
end

